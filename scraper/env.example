# Copy this file to /etc/ai-resume-job-scraper.env on the VPS.
# Keep this file outside Git and set permissions to 600.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JEV uses TYPESAFE_API_KEY. JEV_API_KEY remains supported as an alias.
TYPESAFE_API_KEY=
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

ONLINEJOBS_MAX_PAGES=3
ONLINEJOBS_MAX_JOBS=90
ONLINEJOBS_FETCH_DETAILS=true
ONLINEJOBS_DETAIL_LIMIT=15
ONLINEJOBS_CRAWL_DELAY_SECONDS=5
ONLINEJOBS_STALE_HOURS=72
ONLINEJOBS_CLOSURE_CHECK_ENABLED=true
ONLINEJOBS_CLOSURE_CHECK_LIMIT=100
ONLINEJOBS_CLOSURE_CHECK_HOURS=24
SCRAPER_HTTP_TIMEOUT=30
SCRAPER_DRY_RUN=false
